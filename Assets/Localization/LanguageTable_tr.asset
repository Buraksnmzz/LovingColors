  m_TableData:
  - m_Id: 1
    m_Localized: "T\xFCrk\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Y\xFCkleniyor"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Hakk\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: Geri Bildirim
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Gizlilik Politikas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Kullan\u0131m Ko\u015Fullar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Kupalar
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "\u015Eu ay\u0131n t\xFCm g\xFCnl\xFCk g\xF6revlerini tamamlad\u0131n:"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Al
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "G\xFCnl\xFCk G\xF6rev"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "G\xFCnl\xFCk g\xF6reve ho\u015F geldin"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "G\xFCnl\xFCk oyunlar\u0131 tamamla"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "E\u015Fsiz bir resim ve harika \xF6d\xFCller kazan!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u015Eimdi a\xE7\u0131ld\u0131. Gel ve oyna!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Oyna
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Hamle
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Yeniden Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "\u015Eu g\xFCn\xFCn g\xFCnl\xFCk g\xF6revini tamamlad\u0131n:"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "G\xFCnl\xFCk G\xF6rev Oynan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: Zor
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "A\u015F\u0131r\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: Ipucu
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Tak\u0131ld\u0131n m\u0131? Sonraki hamleni an\u0131nda g\xF6r!"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: Al
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Reklams\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Seviye
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Seviyeden \xE7\u0131kmak istedi\u011Fine emin misin?"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "De\u011Ferlendirme Zaman\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "Oyun ho\u015Funa gitti mi? Bizi de\u011Ferlendir!"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: "Titre\u015Fim"
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Sat\u0131n Almalar\u0131 Geri Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "Oyun hakk\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "\xD6d\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "- Zorunlu reklamlar\u0131 kald\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "- Alt banner reklamlar\u0131n\u0131 kald\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "- \xD6d\xFCll\xFC reklamlar\u0131 izlemeye devam et"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "Reklamlar\u0131 Kald\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Reklams\u0131z Paket"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "Reklams\u0131z"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "\xD6d\xFCl\xFCn:"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "G\xFCnl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "\xC7\u0131k\u0131\u015F?"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: Tamam
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Do\u011Fru yerle\u015Ftirilmi\u015F karolar\u0131 i\u015Faretler
      ve kilitler."
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Seviyenin tamam\u0131 boyunca do\u011Fru yerle\u015Ftirilmi\u015F
      karolar\u0131 i\u015Faretler ve kilitler."
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: Pin
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "S\xFCper Pin"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Hay\u0131r, te\u015Fekk\xFCrler"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: Bedava
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Anlad\u0131m"
    m_Metadata:
      m_Items: []
  references:
