  - m_Id: 60
    m_Localized: Machen wir es uns ein bisschen schwerer!
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: 'Die automatische Sperrung von Kacheln bei korrekter Platzierung
