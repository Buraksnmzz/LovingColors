  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LanguageTable_cs
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: cs
  m_SharedData: {fileID: 11400000, guid: 59a087d5d6a1b448ab32740d371ebe4d, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4259793998027948035
  m_TableData:
  - m_Id: 1
    m_Localized: "\u010De\u0161tina"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "Na\u010D\xEDt\xE1n\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "O h\u0159e"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Zp\u011Btn\xE1 vazba"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Z\xE1sady ochrany osobn\xEDch \xFAdaj\u016F"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "Smluvn\xED podm\xEDnky"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: Trofaje
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "Dokon\u010Dili jste v\u0161echny denn\xED v\xFDzvy pro"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Pokra\u010Dovat"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: Vyzvednout
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Denn\xED v\xFDzva"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "V\xEDtejte v denn\xED v\xFDzv\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Dokon\u010Dete denn\xED hry"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Z\xEDskejte jedine\u010Dn\xFD obr\xE1zek a skv\u011Bl\xE9 odm\u011Bny!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Odem\u010Deno. Poj\u010Fte hr\xE1t!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Hr\xE1t"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Tahy
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: Restart
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Dokon\u010Dili jste denn\xED v\xFDzvu pro"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "Hrajete denn\xED v\xFDzvu"
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "T\u011B\u017Ek\xE1"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "Extr\xE9mn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "N\xE1pov\u011Bda"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Jste v \xFAzk\xFDch? Odhalit dal\u0161\xED tah ihned!"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Z\xEDskat"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Bez reklam
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "\xDArove\u0148"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Opravdu chcete opustit \xFArove\u0148?"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Ano
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: Ne
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "\u010Cas na hodnocen\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "Bav\xED v\xE1s hra? Ohodno\u0165te n\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Hudba
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: Zvuk
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: Vibrace
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Obnovit n\xE1kupy"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: Jazyk
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "O h\u0159e"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Odm\u011Bna"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "- Odstranit povinn\xE9 reklamy"
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "- Odstranit spodn\xED bannery"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "- Ponechat voliteln\xE9 reklamy za odm\u011Bnu"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Odstranit reklamy
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "Bal\xED\u010Dek Bez Reklam"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Bez reklam
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Va\u0161e odm\u011Bna:"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "Denn\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "P\u0159estat?"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "Dob\u0159e"
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Domov
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "Nastaven\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Ozna\u010D\xED a zajist\xED spr\xE1vn\u011B um\xEDst\u011Bn\xE9
      dla\u017Edice"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Ozna\u010Duje a uzamyk\xE1 spr\xE1vn\u011B um\xEDst\u011Bn\xE9
      dla\u017Edice po celou dobu trv\xE1n\xED \xFArovn\u011B"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Kol\xEDk"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: Super pin
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Ne, d\u011Bkuji"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: Uvolnit
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Rozum\xEDm"
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Pot\u0159ebujete pomoc?\\nZa\u010Dn\u011Bte \xFArove\u0148 se super
      odznakem"
    m_Metadata:
      m_Items:
      - rid: 4259793998027948035
  - m_Id: 60
    m_Localized: "Poj\u010Fme si to trochu zkomplikovat!"
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Automatick\xE9 uzam\u010Den\xED dla\u017Edic p\u0159i spr\xE1vn\xE9m
      um\xEDst\u011Bn\xED je nyn\xED deaktivov\xE1no, ale nyn\xED nab\xEDz\xEDme
      dva nov\xE9 boostery, kter\xE9 v\xE1m s t\xEDm pomohou:"
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Ozna\u010Duje a zaji\u0161\u0165uje spr\xE1vn\u011B um\xEDst\u011Bn\xE9
      ty\u010De za pochodu"
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Ozna\u010Duje a uzamyk\xE1 ji\u017E spr\xE1vn\u011B um\xEDst\u011Bn\xE9
      sloupky"
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "Reklamy podporuj\xED v\xFDvoj Loving Colors. Nab\xEDz\xEDme mo\u017Enosti
      hran\xED bez p\u0159eru\u0161en\xED."
    m_Metadata:
      m_Items:
      - rid: 4259793998027948035
  - m_Id: 65
    m_Localized: "Reklamy jsou pro tebe v pohod\u011B."
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Odstranit v\u0161echny vynucen\xE9 reklamy. Odm\u011B\u0148ovan\xE1
      videa z\u016Fstanou voliteln\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: "Hr\xE1t s reklamami"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds:
