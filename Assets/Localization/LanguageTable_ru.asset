      m_Items:
      - rid: 4259793998027948048
  - m_Id: 60
    m_Localized: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0443\u0441\u043B\u043E\u0436\u043D\u0438\u043C \u0437\u0430\u0434\u0430\u0447\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "\u0424\u0443\u043D\u043A\u0446\u0438\u044F \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u043A\u0438 \u043F\u043B\u0438\u0442\u043E\u043A
      \u043F\u0440\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C
      \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u0442\u043A\u043B\u044E\u0447\u0435\u043D\u0430, \u043D\u043E \u043C\u044B
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u043C \u0434\u0432\u0430
      \u043D\u043E\u0432\u044B\u0445 \u0443\u0441\u0438\u043B\u0438\u0442\u0435\u043B\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432\u0430\u043C \u043F\u043E\u043C\u043E\u0433\u0443\u0442:"
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "\u041F\u043E\u043C\u0435\u0447\u0430\u0435\u0442 \u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u0438\u043D\u044B \u043F\u043E
      \u043C\u0435\u0440\u0435 \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "\u041C\u0430\u0440\u043A\u0438\u0440\u0443\u0435\u0442 \u0438 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
