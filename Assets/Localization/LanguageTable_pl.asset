      m_Items: []
  - m_Id: 30
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Czas na recenzj\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "Podoba Ci si\u0119 gra? Oce\u0144 nas!"
