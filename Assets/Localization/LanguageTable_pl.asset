    m_Localized: Poziom
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Czy na pewno chcesz opu\u015Bci\u0107 \u0443\u0440\u043E\u0432\u0435\u043D\u044C?"
