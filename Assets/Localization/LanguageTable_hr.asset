    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Dobrodo\u0161li u dnevni izazov"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Dovr\u0161ite dnevne igre"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: Osvojite jedinstvenu sliku i sjajne nagrade!
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "Otklju\u010Dano. Do\u0111ite igrati!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: Igraj
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: Potezi
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Kreni ispo\u010Detka"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "Zavr\u0161ili ste dnevni izazov za"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: Igranje dnevnog izazova
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Te\u0161ko"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: Ekstremno
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: Savjet
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Zapeli ste? Otkrijte sljede\u0107i potez odmah!"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: Preuzmi
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: Bez oglasa
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Razina
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Jeste li sigurni da \u017Eelite napustiti razinu?"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: Ne
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: Vrijeme za recenziju
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "U\u017Eivate li u igri? Ocijenite nas!"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: Glazba
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: Zvuk
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: Vibracija
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: Vrati kupnje
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: Jezik
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: O igri
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: Nagrada
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: '- Ukloni obvezne oglase'
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: '- Ukloni bannere na dnu'
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "- Zadr\u017Eite neobvezne oglase za nagrade"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: Ukloni oglase
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: Paket Bez Oglasa
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: Bez oglasa
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Va\u0161a nagrada:"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: Dnevno
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: Prestati?
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: U redu
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: Dom
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: Postavke
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "Ozna\u010Dava i zaklju\u010Dava ispravno postavljene plo\u010Dice"
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "Ozna\u010Dava i zaklju\u010Dava ispravno postavljene plo\u010Dice
      tijekom cijelog trajanja razine"
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: "Prikva\u010Di"
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: Super Pin
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: Ne, hvala
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: Besplatno
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: Shvatio/la sam
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "Trebate pomo\u0107?\\nZapo\u010Dnite razinu sa Super Pinom"
    m_Metadata:
      m_Items:
      - rid: 4259793998027948034
  - m_Id: 60
    m_Localized: "U\u010Dinimo stvari malo te\u017Eima!"
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "Automatsko zaklju\u010Davanje plo\u010Dica kada su pravilno postavljene
      sada je onemogu\u0107eno, ali sada nudimo dva nova poja\u010Diva\u010Da koja
      \u0107e vam pomo\u0107i:"
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "Ozna\u010Dava i zaklju\u010Dava pravilno postavljene trake dok
      radite"
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Ozna\u010Dava i zaklju\u010Dava ve\u0107 pravilno postavljene letvice"
    m_Metadata:
      m_Items: []
  - m_Id: 64
    m_Localized: "Oglasi podr\u017Eavaju razvoj Loving Colors\\n\\nNudimo mogu\u0107nosti
      igranja bez prekida."
    m_Metadata:
      m_Items: []
  - m_Id: 65
    m_Localized: Oglasi su ti u redu.
    m_Metadata:
      m_Items: []
  - m_Id: 66
    m_Localized: "Ukloni sve prisilne oglase. Nagradni videozapisi i dalje \u0107e
      biti neobavezni."
    m_Metadata:
      m_Items: []
  - m_Id: 67
    m_Localized: Igraj s oglasima
    m_Metadata:
      m_Items: []
