  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: LanguageTable_vi
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: 59a087d5d6a1b448ab32740d371ebe4d, type: 2}
  m_Metadata:
    m_Items:
    - rid: 4259793998027948052
  m_TableData:
  - m_Id: 1
    m_Localized: "Ti\u1EBFng Vi\u1EC7t"
    m_Metadata:
      m_Items: []
  - m_Id: 2
    m_Localized: "\u0110ang t\u1EA3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3
    m_Localized: "Gi\u1EDBi thi\u1EC7u"
    m_Metadata:
      m_Items: []
  - m_Id: 4
    m_Localized: "Ph\u1EA3n h\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 5
    m_Localized: "Ch\xEDnh s\xE1ch b\u1EA3o m\u1EADt"
    m_Metadata:
      m_Items: []
  - m_Id: 6
    m_Localized: "\u0110i\u1EC1u kho\u1EA3n d\u1ECBch v\u1EE5"
    m_Metadata:
      m_Items: []
  - m_Id: 7
    m_Localized: "C\xFAp"
    m_Metadata:
      m_Items: []
  - m_Id: 8
    m_Localized: "B\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh t\u1EA5t c\u1EA3 th\u1EED
      th\xE1ch h\u1EB1ng ng\xE0y cho"
    m_Metadata:
      m_Items: []
  - m_Id: 9
    m_Localized: "Ti\u1EBFp t\u1EE5c"
    m_Metadata:
      m_Items: []
  - m_Id: 10
    m_Localized: "Nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 11
    m_Localized: "Th\u1EED th\xE1ch h\u1EB1ng ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 12
    m_Localized: "Ch\xE0o m\u1EEBng \u0111\u1EBFn v\u1EDBi th\u1EED th\xE1ch h\u1EB1ng
      ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Ho\xE0n th\xE0nh c\xE1c tr\xF2 ch\u01A1i h\u1EB1ng ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "Nh\u1EADn h\xECnh \u1EA3nh \u0111\u1ED9c \u0111\xE1o v\xE0 v\xF4
      s\u1ED1 ph\u1EA7n th\u01B0\u1EDFng l\u1EDBn!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: "\u0110\xE3 m\u1EDF kh\xF3a. V\xE0o ch\u01A1i ngay!"
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "N\u01B0\u1EDBc \u0111i"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Ch\u01A1i l\u1EA1i"
    m_Metadata:
      m_Items: []
  - m_Id: 19
    m_Localized: "B\u1EA1n \u0111\xE3 ho\xE0n th\xE0nh th\u1EED th\xE1ch h\u1EB1ng
      ng\xE0y cho"
    m_Metadata:
      m_Items: []
  - m_Id: 20
    m_Localized: "\u0110ang ch\u01A1i Th\u1EED th\xE1ch h\u1EB1ng ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 21
    m_Localized: "Kh\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 22
    m_Localized: "C\u1EF1c kh\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 23
    m_Localized: "G\u1EE3i \xFD"
    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "B\u1ECB k\u1EB9t? Xem ngay n\u01B0\u1EDBc \u0111i ti\u1EBFp theo!"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Nh\u1EADn"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "Kh\xF4ng qu\u1EA3ng c\xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: "M\xE0n"
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "B\u1EA1n c\xF3 ch\u1EAFc ch\u1EAFn mu\u1ED1n tho\xE1t m\xE0n ch\u01A1i?"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: "C\xF3"
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: "Kh\xF4ng"
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "\u0110\xE1nh gi\xE1 ngay"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "B\u1EA1n c\xF3 th\xEDch tr\xF2 ch\u01A1i kh\xF4ng? H\xE3y \u0111\xE1nh
      gi\xE1 nh\xE9!"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "\xC2m nh\u1EA1c"
    m_Metadata:
      m_Items: []
  - m_Id: 34
    m_Localized: "\xC2m thanh"
    m_Metadata:
      m_Items: []
  - m_Id: 35
    m_Localized: Rung
    m_Metadata:
      m_Items: []
  - m_Id: 36
    m_Localized: "Kh\xF4i ph\u1EE5c mua h\xE0ng"
    m_Metadata:
      m_Items: []
  - m_Id: 37
    m_Localized: "Ng\xF4n ng\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 38
    m_Localized: "V\u1EC1 tr\xF2 ch\u01A1i"
    m_Metadata:
      m_Items: []
  - m_Id: 39
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 40
    m_Localized: "- X\xF3a qu\u1EA3ng c\xE1o b\u1EAFt bu\u1ED9c"
    m_Metadata:
      m_Items: []
  - m_Id: 41
    m_Localized: "- X\xF3a qu\u1EA3ng c\xE1o bi\u1EC3u ng\u1EEF b\xEAn d\u01B0\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 42
    m_Localized: "- Gi\u1EEF qu\u1EA3ng c\xE1o t\u1EF1 ch\u1ECDn \u0111\u1EC3 nh\u1EADn
      th\u01B0\u1EDFng"
    m_Metadata:
      m_Items: []
  - m_Id: 43
    m_Localized: "X\xF3a qu\u1EA3ng c\xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 44
    m_Localized: "G\xF3i Kh\xF4ng qu\u1EA3ng c\xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 45
    m_Localized: "Kh\xF4ng qu\u1EA3ng c\xE1o"
    m_Metadata:
      m_Items: []
  - m_Id: 46
    m_Localized: "Ph\u1EA7n th\u01B0\u1EDFng c\u1EE7a b\u1EA1n:"
    m_Metadata:
      m_Items: []
  - m_Id: 47
    m_Localized: "H\u1EB1ng ng\xE0y"
    m_Metadata:
      m_Items: []
  - m_Id: 48
    m_Localized: "T\u1EEB b\u1ECF?"
    m_Metadata:
      m_Items: []
  - m_Id: 49
    m_Localized: "\u0110\u01B0\u1EE3c r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 50
    m_Localized: "Trang ch\u1EE7"
    m_Metadata:
      m_Items: []
  - m_Id: 51
    m_Localized: "C\xE0i \u0111\u1EB7t"
    m_Metadata:
      m_Items: []
  - m_Id: 52
    m_Localized: "\u0110\xE1nh d\u1EA5u v\xE0 kh\xF3a c\xE1c \xF4 g\u1EA1ch \u0111\xE3
      \u0111\u01B0\u1EE3c \u0111\u1EB7t \u0111\xFAng v\u1ECB tr\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 53
    m_Localized: "\u0110\xE1nh d\u1EA5u v\xE0 kh\xF3a c\xE1c \xF4 \u0111\u01B0\u1EE3c
      \u0111\u1EB7t \u0111\xFAng v\u1ECB tr\xED trong su\u1ED1t th\u1EDDi gian ho\xE0n
      th\xE0nh m\xE0n ch\u01A1i."
    m_Metadata:
      m_Items: []
  - m_Id: 54
    m_Localized: Ghim
    m_Metadata:
      m_Items: []
  - m_Id: 55
    m_Localized: "Ghim si\xEAu c\u1EA5p"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "Kh\xF4ng, c\u1EA3m \u01A1n"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "Mi\u1EC5n ph\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "Hi\u1EC3u r\u1ED3i"
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "C\u1EA7n tr\u1EE3 gi\xFAp?\\nB\u1EAFt \u0111\u1EA7u m\xE0n ch\u01A1i
      v\u1EDBi m\u1ED9t Ghim Si\xEAu C\u1EA5p"
    m_Metadata:
      m_Items:
      - rid: 4259793998027948052
  - m_Id: 60
    m_Localized: "H\xE3y l\xE0m m\u1ECDi th\u1EE9 kh\xF3 kh\u0103n h\u01A1n m\u1ED9t
      ch\xFAt!"
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "T\xEDnh n\u0103ng t\u1EF1 \u0111\u1ED9ng kh\xF3a \xF4 khi \u0111\u1EB7t
      \u0111\xFAng v\u1ECB tr\xED hi\u1EC7n \u0111\xE3 b\u1ECB v\xF4 hi\u1EC7u h\xF3a,
      nh\u01B0ng ch\xFAng t\xF4i hi\u1EC7n \u0111ang cung c\u1EA5p hai v\u1EADt ph\u1EA9m
      h\u1ED7 tr\u1EE3 m\u1EDBi \u0111\u1EC3 gi\xFAp b\u1EA1n:"
    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: "\u0110\xE1nh d\u1EA5u v\xE0 kh\xF3a c\xE1c \xF4 \u0111\xE3 \u0111\u01B0\u1EE3c
      \u0111\u1EB7t \u0111\xFAng v\u1ECB tr\xED khi b\u1EA1n th\u1EF1c hi\u1EC7n."
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "\u0110\xE1nh d\u1EA5u v\xE0 kh\xF3a c\xE1c \xF4 \u0111\xE3 \u0111\u01B0\u1EE3c
      \u0111\u1EB7t \u0111\xFAng v\u1ECB tr\xED."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds:
