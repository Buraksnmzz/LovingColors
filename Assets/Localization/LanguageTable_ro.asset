    m_Metadata:
      m_Items: []
  - m_Id: 24
    m_Localized: "Te-ai blocat? Dezv\u0103luie urm\u0103toarea mutare instant!"
    m_Metadata:
      m_Items: []
  - m_Id: 25
    m_Localized: "Ob\u021Bine"
    m_Metadata:
      m_Items: []
  - m_Id: 26
    m_Localized: "F\u0103r\u0103 reclame"
    m_Metadata:
      m_Items: []
  - m_Id: 27
    m_Localized: Nivel
    m_Metadata:
      m_Items: []
  - m_Id: 28
    m_Localized: "Sigur dori\u021Bi s\u0103 p\u0103r\u0103si\u021Bi nivelul?"
    m_Metadata:
      m_Items: []
  - m_Id: 29
    m_Localized: Da
    m_Metadata:
      m_Items: []
  - m_Id: 30
    m_Localized: Nu
    m_Metadata:
      m_Items: []
  - m_Id: 31
    m_Localized: "Timpul evalu\u0103rii"
    m_Metadata:
      m_Items: []
  - m_Id: 32
    m_Localized: "\xCE\u021Bi place jocul? Evalueaz\u0103-ne!"
    m_Metadata:
      m_Items: []
  - m_Id: 33
    m_Localized: "Muzic\u0103"
    m_Metadata:
