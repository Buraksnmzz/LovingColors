    m_Metadata:
      m_Items: []
  - m_Id: 13
    m_Localized: "Finalizeaz\u0103 jocurile zilnice"
    m_Metadata:
      m_Items: []
  - m_Id: 14
    m_Localized: "C\xE2\u0219tig\u0103 o imagine unic\u0103 \u0219i recompense excelente!"
    m_Metadata:
      m_Items: []
  - m_Id: 15
    m_Localized: Deblocat acum. Hai la joc!
    m_Metadata:
      m_Items: []
  - m_Id: 16
    m_Localized: "Joac\u0103"
    m_Metadata:
      m_Items: []
  - m_Id: 17
    m_Localized: "Mut\u0103ri"
    m_Metadata:
      m_Items: []
  - m_Id: 18
    m_Localized: "Reporne\u0219te"
    m_Metadata:
      m_Items: []
