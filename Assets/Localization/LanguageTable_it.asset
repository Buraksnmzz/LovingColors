      m_Items:
      - rid: 4259793998027948042
  - m_Id: 60
    m_Localized: "Rendiamo le cose un po' pi\xF9 difficili!"
    m_Metadata:
      m_Items: []
  - m_Id: 61
    m_Localized: "La funzione di blocco automatico delle tessere posizionate correttamente
