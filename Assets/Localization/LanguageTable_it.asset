    m_Metadata:
      m_Items: []
  - m_Id: 62
    m_Localized: Segna e blocca le caselle posizionate correttamente mentre procedi
    m_Metadata:
      m_Items: []
  - m_Id: 63
    m_Localized: "Contrassegna e blocca le piastrelle gi\xE0 posizionate correttamente"
